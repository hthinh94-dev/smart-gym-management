{
  "info": {
    "_postman_id": "97c29ec9-3170-4e38-9395-b1653996e1e8",
    "name": "Smart Gym - Day 7 Register and Login",
    "description": "Local verification for UC-01 registration and UC-02 login/current user. Run requests in collection order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "registerEmail",
      "value": ""
    },
    {
      "key": "duplicateEmail",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register - Success 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = `member.${Date.now()}@smartgym.test`;",
              "pm.collectionVariables.set('registerEmail', email);",
              "pm.collectionVariables.set('duplicateEmail', `  ${email.toUpperCase()}  `);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('ACTIVE ROLE_MEMBER without secret fields', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.email).to.eql(pm.collectionVariables.get('registerEmail'));",
              "  pm.expect(body.data.role).to.eql('ROLE_MEMBER');",
              "  pm.expect(body.data.accountStatus).to.eql('ACTIVE');",
              "  pm.expect(body.data).not.to.have.any.keys('password', 'passwordHash', 'confirmPassword', 'accessToken');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"  Nguyen Van An  \",\n  \"email\": \"  {{registerEmail}}  \",\n  \"password\": \"SecurePass1\",\n  \"confirmPassword\": \"SecurePass1\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - Duplicate Email ACC-001",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409 ACC-001', () => {",
              "  pm.response.to.have.status(409);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.errorCode).to.eql('ACC-001');",
              "  pm.expect(body.details.field).to.eql('email');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nguyen Van An\",\n  \"email\": \"{{duplicateEmail}}\",\n  \"password\": \"SecurePass1\",\n  \"confirmPassword\": \"SecurePass1\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - Weak Password ACC-002",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400 ACC-002', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().errorCode).to.eql('ACC-002');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nguyen Van An\",\n  \"email\": \"weak.password@smartgym.test\",\n  \"password\": \"password\",\n  \"confirmPassword\": \"password\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - Confirm Password ACC-002",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400 ACC-002 for confirmPassword', () => {",
              "  pm.response.to.have.status(400);",
              "  const body = pm.response.json();",
              "  pm.expect(body.errorCode).to.eql('ACC-002');",
              "  pm.expect(body.details.field).to.eql('confirmPassword');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nguyen Van An\",\n  \"email\": \"confirm.password@smartgym.test\",\n  \"password\": \"SecurePass1\",\n  \"confirmPassword\": \"DifferentPass1\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - Invalid Email VAL-001",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400 VAL-001', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().errorCode).to.eql('VAL-001');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nguyen Van An\",\n  \"email\": \"invalid-email\",\n  \"password\": \"SecurePass1\",\n  \"confirmPassword\": \"SecurePass1\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Register - Ignore Client Role And Status",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('privilegeEmail', `privilege.${Date.now()}@smartgym.test`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Client cannot assign ADMIN or DISABLED', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.role).to.eql('ROLE_MEMBER');",
              "  pm.expect(body.data.accountStatus).to.eql('ACTIVE');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Privilege Attempt\",\n  \"email\": \"{{privilegeEmail}}\",\n  \"password\": \"SecurePass1\",\n  \"confirmPassword\": \"SecurePass1\",\n  \"role\": \"ROLE_ADMIN\",\n  \"accountStatus\": \"DISABLED\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login - Success 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 with configured JWT contract', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.tokenType).to.eql('Bearer');",
              "  pm.expect(body.data.expiresIn).to.be.a('number').and.above(0);",
              "  pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('registerEmail'));",
              "  pm.expect(body.data.user.role).to.eql('ROLE_MEMBER');",
              "  pm.expect(body.data).not.to.have.any.keys('password', 'passwordHash');",
              "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"  {{registerEmail}}  \",\n  \"password\": \"SecurePass1\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login - Wrong Password ACC-007",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401 ACC-007 without token', () => {",
              "  pm.response.to.have.status(401);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.errorCode).to.eql('ACC-007');",
              "  pm.expect(body.details).to.be.an('object');",
              "  pm.expect(body).not.to.have.any.keys('accessToken', 'password', 'passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"WrongPassword1\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Current User - Success 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 returns authenticated principal', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.email).to.eql(pm.collectionVariables.get('registerEmail'));",
              "  pm.expect(body.data.role).to.eql('ROLE_MEMBER');",
              "  pm.expect(body.data.accountStatus).to.eql('ACTIVE');",
              "  pm.expect(body.data).not.to.have.any.keys('password', 'passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Current User - Invalid Token ACC-005",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401 ACC-005 for malformed JWT', () => {",
              "  pm.response.to.have.status(401);",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.errorCode).to.eql('ACC-005');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer malformed.jwt.token"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Current User - Missing Token ACC-005",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401 ACC-005 without Authorization', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().errorCode).to.eql('ACC-005');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me"
      }
    }
  ]
}
