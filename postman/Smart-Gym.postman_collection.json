    {
      "name": "Day 8 - Admin Account Status",
      "description": "Set adminEmail, adminPassword, memberEmail, memberPassword and memberId as local collection values. Do not commit real credentials or tokens.",
      "item": [
        {
          "name": "01 - Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login returns ROLE_ADMIN', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.user.role).to.eql('ROLE_ADMIN');",
                  "  pm.collectionVariables.set('adminToken', body.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "02 - Member Login Before Lock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Member login stores the pre-lock token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.user.role).to.eql('ROLE_MEMBER');",
                  "  pm.collectionVariables.set('memberOldToken', body.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "03 - Admin Users Search And Filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin receives a paged Member list', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.content).to.be.an('array');",
                  "  pm.expect(body.data).to.include.all.keys('totalElements', 'totalPages', 'currentPage', 'pageSize');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users?page=0&size=20&role=ROLE_MEMBER&status=ACTIVE&search={{memberEmail}}"
          }
        },
        {
          "name": "04 - Member Calls Admin API AUTH-002",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Member is denied by Admin RBAC', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('AUTH-002');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberOldToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "05 - Admin Lock Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ACTIVE Member becomes LOCKED without subscription change', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.accountStatus).to.eql('LOCKED');",
                  "  pm.expect(body.data.subscriptionStatus).to.include('không thay đổi');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Vi phạm nội quy phòng tập nhiều lần.\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{memberId}}/lock"
          }
        },
        {
          "name": "06 - Old Member Token ACC-004",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pre-lock token is blocked by AccountStatusGuard', () => {",
                  "  pm.response.to.have.status(403);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errorCode).to.eql('ACC-004');",
                  "  pm.expect(body.details.accountStatus).to.eql('LOCKED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberOldToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "07 - Locked Member Login ACC-004",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOCKED Member cannot receive a new token', () => {",
                  "  pm.response.to.have.status(403);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errorCode).to.eql('ACC-004');",
                  "  pm.expect(body).not.to.have.property('accessToken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "08 - Admin Unlock Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOCKED Member returns to ACTIVE', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.accountStatus).to.eql('ACTIVE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{memberId}}/unlock"
          }
        },
        {
          "name": "09 - Member Login After Unlock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unlocked Member receives a new token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.user.role).to.eql('ROLE_MEMBER');",
                  "  pm.collectionVariables.set('memberToken', body.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "10 - Admin Users Missing Token ACC-005",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing token is rejected before Admin RBAC', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().errorCode).to.eql('ACC-005');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/users"
          }
        }
      ]
