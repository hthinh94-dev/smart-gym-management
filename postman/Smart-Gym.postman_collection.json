    {
      "name": "Day 12-13 - Member Profile and Calculator",
      "description": "Run after memberToken has been populated. Profile and calculated targets are prerequisites for later M2/M3 Member flows.",
      "item": [
        {
          "name": "01 - Upsert Member Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile upsert returns calculated targets', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.bioProfile.weightKg).to.eql(72.2);",
                  "  pm.expect(body.data.calculatedTargets).to.include.all.keys('bmi', 'bmr', 'tdee', 'dailyCaloriesKcal', 'proteinGrams', 'fatGrams', 'carbGrams');",
                  "  pm.expect(body.data).not.to.have.any.keys('password', 'passwordHash', 'accessToken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gender\": \"MALE\",\n  \"dateOfBirth\": \"2000-01-15\",\n  \"heightCm\": 175,\n  \"weightKg\": 72.2,\n  \"fitnessGoal\": \"MAINTAIN\",\n  \"fitnessLevel\": \"BEGINNER\",\n  \"activityLevel\": \"MODERATELY_ACTIVE\",\n  \"workoutDaysPerWeek\": 4,\n  \"maxSessionMinutes\": 75,\n  \"availableEquipment\": [\"BARBELL\", \"DUMBBELL\"],\n  \"targetMuscleGroups\": [\"CHEST\", \"BACK\", \"LEGS\"],\n  \"injuryConstraints\": [],\n  \"dietaryPreference\": \"OMNIVORE\",\n  \"foodAllergies\": [],\n  \"excludedFoods\": [],\n  \"mealsPerDay\": 4\n}"
            },
            "url": "{{baseUrl}}/member/profile"
          }
        },
        {
          "name": "02 - Get Current Member Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile GET returns the principal owner only', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.include.all.keys('memberId', 'bioProfile', 'nutritionProfile', 'calculatedTargets', 'updatedAt');",
                  "  pm.expect(body.data.bioProfile.weightKg).to.eql(72.2);",
