# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_gym_management
DB_USER=
DB_PASSWORD=
# Optional override for the assembled JDBC URL above:
# DB_URL=jdbc:mysql://localhost:3306/smart_gym_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# Security
# Generate a unique secret with at least 32 bytes. Never commit the real value.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000

# Web CORS (comma-separated explicit origins; never use wildcard for staging/production)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Example with staging: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://staging.smartgym.example.com

# Third-party Integrations
AI_API_KEY=
